# ============================================
# 编译产物
# ============================================

# C 编译产物
flow-monitor/bin/
flow-monitor/obj/
flow-monitor/*.o
flow-monitor/*.out
flow-monitor/flow_monitor

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ============================================
# 虚拟环境
# ============================================
venv/
.venv/
env/
.env/
*.virtualenv

